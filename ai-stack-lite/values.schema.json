{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-stack-lite values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "runtimeClassName": {
              "type": "string"
            }
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skip": {
              "type": "boolean"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "extraLabels": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "ollama": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "open-webui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "comfyui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "vramMode": {
          "type": "string",
          "enum": [
            "default",
            "lowvram",
            "novram",
            "highvram",
            "gpu-only",
            "cpu"
          ],
          "description": "ComfyUI VRAM strategy. 'default' passes no flag and is correct for a shared GPU; highvram and gpu-only pin weights in VRAM."
        }
      }
    }
  }
}
